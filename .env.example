# ---- LLM 后端（留空 = 使用内置 MockLLM，零成本可跑通所有 lab）----
LLM_BACKEND=mock            # mock | openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # 也可是 Ollama / vLLM / 任意 OpenAI 兼容网关
OPENAI_MODEL=gpt-4o-mini

# ---- 阶段三 solver 才会用到 ----
CTFD_URL=
CTFD_TOKEN=
MAX_PARALLEL_SOLVERS=3
SANDBOX_IMAGE=agent-ctf-sandbox:latest
